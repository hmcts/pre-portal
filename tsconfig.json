{
  "compilerOptions": {
    "outDir": "./src/",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "lib": ["es2020", "dom", "dom.iterable"],
    "baseUrl": "src/main",
    "paths": {
      "router/*": ["router/*"],
      "routes/*": ["routes/*"]
    }
  },
  "exclude": ["**/*.test.ts", "**/codecept.conf.ts", "**/__mocks__/*", "**/saucelabs.conf.ts"]
}
